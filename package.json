{
  "name": "habit-tracker",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/urbanist": "0.4.2",
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "jest-expo": "~58.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "privacy:check": "node scripts/privacy-check.mjs",
    "start": "node scripts/sync-art.mjs && expo start",
    "android": "node scripts/sync-art.mjs && expo start --android",
    "ios": "node scripts/sync-art.mjs && expo start --ios",
    "web": "node scripts/sync-art.mjs && expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "export:web": "node scripts/sync-art.mjs && expo export -p web",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepare": "husky",
    "art:sync": "node scripts/sync-art.mjs",
    "postinstall": "node scripts/sync-art.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:record": "playwright test --config playwright.record.config.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/e2e/"
    ],
    "collectCoverageFrom": [
      "src/rules/**/*.ts",
      "src/features/**/state.ts",
      "!src/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
